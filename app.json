{
  "expo": {
    "name": "Backlog",
    "slug": "backlog",
    "version": "1.9.0",
    "orientation": "portrait",
    "scheme": "backlog",
    "icon": "./assets/images/icon.png",
    "android": {
      "backgroundColor": "#000000",
      "package": "com.nonolpmod.backlog",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/PublicSans-Regular.ttf"]
        }
      ],
      "./plugins/withAndroidConfigChanges",
      "./plugins/withAndroidTheme",
      "./plugins/withAsyncStorageSize",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
